rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reemplazá TU_UID_ADMIN por el UID de tu usuario (Authentication > Usuarios > columna "UID de usuario").
    function esAdmin() {
      return request.auth != null && request.auth.uid in ['TU_UID_ADMIN'];
    }

    // Pedido que puede crear cualquier visitante desde el armador (solo crear, nunca leer ni modificar).
    function pedidoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['qn','nombre','tel','email','direccion','notas','entrega','s','extras','dto','armado','envio',
                               'estado','creado','acepto','origen','totalVisto'])
        && d.keys().hasAll(['qn','nombre','tel','entrega','s','estado','creado','acepto','origen','totalVisto'])
        && d.estado == 'Nuevo' && d.origen == 'web' && d.acepto == true
        && d.creado == request.time
        && d.qn is string && d.qn.size() >= 6 && d.qn.size() <= 20
        && d.nombre is string && d.nombre.size() >= 2 && d.nombre.size() <= 80
        && d.tel is string && d.tel.size() >= 6 && d.tel.size() <= 30
        && (!('email' in d) || (d.email is string && d.email.size() <= 120))
        && (!('direccion' in d) || (d.direccion is string && d.direccion.size() <= 200))
        && (!('notas' in d) || (d.notas is string && d.notas.size() <= 500))
        && d.entrega in ['retiro', 'envio']
        && d.s is map && d.s.size() >= 1 && d.s.size() <= 7
        && (!('extras' in d) || (d.extras is list && d.extras.size() == 0))
        && d.totalVisto is number && d.totalVisto >= 0 && d.totalVisto < 100000000;
    }

    // Precios de venta: los lee cualquiera, solo vos (o el robot semanal con la cuenta de servicio) los escribís.
    match /publico/{doc} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Costos, margen y reportes: solo administrador.
    match /privado/{doc} {
      allow read, write: if esAdmin();
    }

    match /pedidos/{id} {
      allow read, update, delete: if esAdmin();
      allow create: if esAdmin() || pedidoValido();
    }
  }
}
